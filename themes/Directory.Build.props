<Project>

  <!-- Import root Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"
          Condition="'' != $([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- ── Build options ────────────────────────────────────────────────── -->
    <Configurations>Debug;Release</Configurations>
    <DebugSymbols>true</DebugSymbols>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- ── Compiler options ─────────────────────────────────────────────── -->
    <Deterministic>true</Deterministic>

    <!-- ── Error and warning options ────────────────────────────────────── -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>

    <!-- ── Output options ───────────────────────────────────────────────── -->
    <OutputType>library</OutputType>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>

    <!-- ── Packaging options ────────────────────────────────────────────── -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSource>false</IncludeSource>
    <IncludeSymbols>false</IncludeSymbols>
    <IsPackable>true</IsPackable>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/OscarNET-SOFTware/Retro.TUI.Framework</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>tui;retro;skia;skiasharp;sdl2;terminal;ui;framework;dotnet;theme</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/OscarNET-SOFTware/Retro.TUI.Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- ── Debug configuration ────────────────────────────────────────────── -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>portable</DebugType>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
  </PropertyGroup>

  <!-- ── Release configuration ──────────────────────────────────────────── -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>embedded</DebugType>
    <DefineConstants>TRACE;RELEASE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- ── Global usings ──────────────────────────────────────────────────── -->
  <!-- System.* namespaces are already covered by ImplicitUsings.            -->
  <!-- Only namespaces not included by default are listed here.              -->
  <ItemGroup>
    <!-- Required for [NotNull], [MaybeNull], [NotNullWhen] etc.             -->
    <!-- used extensively in the public API contracts.                       -->
    <Using Include="System.Diagnostics.CodeAnalysis" />
  </ItemGroup>

  <!-- ── NuGet package content files ────────────────────────────────────── -->
  <!-- MSBuild needs explicit paths to physical files so dotnet pack can     -->
  <!-- embed them. PackageIcon/PackageReadmeFile above only                  -->
  <!-- declare the names; these None items point to the actual files at      -->
  <!-- the repo root.                                                        -->
  <!-- $(MSBuildThisFileDirectory) = src\  →  ..\ = repo root                -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\icon.png"
          Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md"
          Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.md"
          Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
